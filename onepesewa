install_python_telegram() {
    # Echo the interpreter that can import python-telegram-bot (>=20), or return 1.
    local py
    py=/usr/bin/python3
    command -v "$py" >/dev/null 2>&1 || py=$(command -v python3 2>/dev/null)
    [ -n "$py" ] || return 1
    "$py" -c "import telegram, telegram.ext" >/dev/null 2>&1 && { echo "$py"; return 0; }
    if ! "$py" -m pip --version >/dev/null 2>&1; then
        apt-get update -qq >/dev/null 2>&1
        apt-get install -y python3-pip -qq >/dev/null 2>&1
    fi
    if "$py" -m pip install --upgrade "python-telegram-bot>=20.0" >/dev/null 2>&1 \
        && "$py" -c "import telegram, telegram.ext" >/dev/null 2>&1; then echo "$py"; return 0; fi
    if "$py" -m pip install --upgrade --break-system-packages "python-telegram-bot>=20.0" >/dev/null 2>&1 \
        && "$py" -c "import telegram, telegram.ext" >/dev/null 2>&1; then echo "$py"; return 0; fi
    apt-get install -y python3-venv -qq >/dev/null 2>&1
    if "$py" -m venv /opt/opudp-bot-venv >/dev/null 2>&1 \
        && /opt/opudp-bot-venv/bin/pip install --upgrade "python-telegram-bot>=20.0" >/dev/null 2>&1 \
        && /opt/opudp-bot-venv/bin/python -c "import telegram, telegram.ext" >/dev/null 2>&1; then
        echo "/opt/opudp-bot-venv/bin/python"; return 0
    fi
    return 1
}


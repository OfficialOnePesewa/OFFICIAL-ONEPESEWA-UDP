        local bs
        systemctl is-active --quiet opudp-bot 2>/dev/null && bs="${GRN}● Running${RST}" || bs="${RED}● Stopped${RST}"
        echo -e "  Bot Status: $bs\n"
        echo -e "  ${GRN}[1]${RST} Set Bot Token      ${GRN}[2]${RST} Start Bot"

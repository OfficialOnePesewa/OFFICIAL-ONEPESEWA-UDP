# ══════════════════════════════════════════════════════════════
#  TELEGRAM BOT CLI (non-interactive)
#  Invoked as: onepesewa --bot-<command> [args]
#  Prints plain text (no ANSI colours) so Telegram renders it cleanly.
# ══════════════════════════════════════════════════════════════

# Remove every line whose first "|" field equals $2 from file $1.
bot_del_line() {
    local file="$1" pass="$2" tmp
    [ -f "$file" ] || return 0
    tmp=$(mktemp 2>/dev/null) || return 0
    awk -F'|' -v p="$pass" '$1 != p' "$file" > "$tmp" 2>/dev/null && mv "$tmp" "$file" 2>/dev/null
}

bot_add_user_record() {
    # $1=password $2=expiry $3=quota $4=hwid
    local finalpass="$1" exp="$2" quota="$3" hwid="$4" port
    port=$(find_free_port)
    [ -z "$port" ] && { echo "ERROR: No free ports."; return 1; }
    mkdir -p "$(dirname "$CONFIG")"
    [ -f "$CONFIG" ] || echo '{"auth":{"config":[]}}' > "$CONFIG"
    jq --arg p "$finalpass" '.auth.config += [$p]' "$CONFIG" > /tmp/zivpn_tmp.json 2>/dev/null && mv /tmp/zivpn_tmp.json "$CONFIG"
    echo "${finalpass}|${exp}|${quota}|${port}|${hwid}|0" >> "$DB"
    echo "${finalpass}|0" >> "$USAGE_DB"
    echo "${finalpass}|${hwid}" >> "$HWID_ALLOWED_DB"
    setup_tracking "$port"
    systemctl restart zivpn 2>/dev/null
    echo "${port}"
}

bot_status() {
    local svc users upt
    systemctl is-active --quiet zivpn 2>/dev/null && svc="Online" || svc="Offline"
    users=$([ -f "$DB" ] && grep -c . "$DB" 2>/dev/null || echo 0)
    upt=$(uptime -p 2>/dev/null | sed 's/^up //')
    echo "OP UDP Server Status"
    echo "--------------------"
    echo "Service : $svc"
    echo "Users   : $users"
    echo "IP      : ${IP:-N/A}"
    echo "Location: ${CITY:-Unknown}, ${COUNTRY:-Unknown}"
    echo "ISP     : ${ISP:-Unknown}"
    echo "Uptime  : ${upt:-N/A}"
}

bot_list() {
    if [ ! -f "$DB" ] || [ ! -s "$DB" ]; then echo "No users found."; return 0; fi
    printf "%-22s %-12s %-8s %-6s %-7s\n" "PASSWORD" "REMAINING" "QUOTA" "PORT" "STATUS"
    while IFS='|' read -r pass exp quota port hwid used; do
        [ -z "$pass" ] && continue
        local status
        if is_expired "$exp"; then status="Expired"; else status="Active"; fi
        [ -n "$(get_pause_remaining "$pass")" ] && status="Paused"
        printf "%-22s %-12s %-8s %-6s %-7s\n" "${pass:0:22}" "$(expiry_human "$exp")" "$quota" "$port" "$status"
    done < "$DB"
}

bot_userstatus() {
    local pass="$1" line
    [ -z "$pass" ] && { echo "Usage: --bot-userstatus <password>"; return 2; }
    line=$(awk -F'|' -v p="$pass" '$1 == p {print; exit}' "$DB" 2>/dev/null)
    [ -z "$line" ] && { echo "Password not found."; return 1; }
    IFS='|' read -r p expiry quota port hwid used <<< "$line"
    local used_b="${used:-0}"
    local quota_b; quota_b=$(quota_to_bytes "$quota")
    local remain_b=$(( quota_b > used_b ? quota_b - used_b : 0 ))
    local status
    if is_expired "$expiry"; then status="Expired"; else status="Active"; fi
    [ -n "$(get_pause_remaining "$pass")" ] && status="Paused"
    echo "Account Status"
    echo "--------------"
    echo "Password : $p"
    echo "Expiry   : $expiry ($(expiry_human "$expiry") left)"
    echo "Quota    : $quota"
    echo "Used     : $(bytes_human "$used_b")"
    echo "Remaining: $(bytes_human "$remain_b")"
    echo "HWID     : $hwid"
    echo "Port     : $port"
    echo "Status   : $status"
}

bot_adduser() {
    local pass="$1" duration="$2" quota="$3" hwid="$4"
    if [ -z "$pass" ] || [ -z "$duration" ] || [ -z "$quota" ]; then
        echo "Usage: --bot-adduser <password> <duration> <quota> <hwid>"; return 2
    fi
    local dsecs; dsecs=$(dur_to_seconds "$duration")
    [ "$dsecs" -le 0 ] && { echo "ERROR: Invalid duration (use e.g. 2d4h30m)."; return 1; }
    [ -z "$hwid" ] && hwid="any"
    awk -F'|' -v p="$pass" '$1 == p {found=1} END{exit !found}' "$DB" 2>/dev/null && \
        { echo "ERROR: Password already exists."; return 1; }
    local exp; exp=$(date -d "+${dsecs} seconds" +"%Y-%m-%d %H:%M:%S" 2>/dev/null)
    [ -z "$exp" ] && { echo "ERROR: Date conversion failed."; return 1; }
    local port; port=$(bot_add_user_record "$pass" "$exp" "$quota" "$hwid")
    if [ -z "$port" ] || [[ "$port" == ERROR* ]]; then echo "${port:-ERROR: Failed to create user.}"; return 1; fi
    echo "User created."
    echo "Password: $pass"
    echo "Expiry  : $exp"
    echo "Runs for: $(expiry_human "$exp")"
    echo "Quota   : $quota"
    echo "Port    : $port"
    echo "Server  : ${IP:-N/A}"
}

bot_removeuser() {
    local pass="$1"
    [ -z "$pass" ] && { echo "Usage: --bot-removeuser <password>"; return 2; }
    local line; line=$(awk -F'|' -v p="$pass" '$1 == p {print; exit}' "$DB" 2>/dev/null)
    [ -z "$line" ] && { echo "User not found."; return 1; }
    local port; port=$(echo "$line" | cut -d'|' -f4)
    [ -n "$port" ] && remove_tracking "$port"
    [ -f "$CONFIG" ] && jq --arg p "$pass" '.auth.config -= [$p]' "$CONFIG" > /tmp/zivpn_tmp.json 2>/dev/null && mv /tmp/zivpn_tmp.json "$CONFIG"
    bot_del_line "$DB" "$pass"
    bot_del_line "$USAGE_DB" "$pass"
    bot_del_line "$CONN_LIMIT_FILE" "$pass"
    bot_del_line "$IP_LIMIT_FILE" "$pass"
    bot_del_line "$PAUSE_DB" "$pass"
    bot_del_line "$HWID_ALLOWED_DB" "$pass"
    rm -f "/etc/zivpn/iplist_${pass}.db" 2>/dev/null
    systemctl restart zivpn 2>/dev/null
    echo "User removed: $pass"
}

bot_renew() {
    local pass="$1" duration="$2"
    if [ -z "$pass" ] || [ -z "$duration" ]; then echo "Usage: --bot-renew <password> <duration>"; return 2; fi
    local dsecs; dsecs=$(dur_to_seconds "$duration")
    [ "$dsecs" -le 0 ] && { echo "ERROR: Invalid duration (use e.g. 2d4h30m)."; return 1; }
    local line; line=$(awk -F'|' -v p="$pass" '$1 == p {print; exit}' "$DB" 2>/dev/null)
    [ -z "$line" ] && { echo "User not found."; return 1; }
    local oldexp; oldexp=$(echo "$line" | cut -d'|' -f2)
    local newexp; newexp=$(date -d "+${dsecs} seconds" +"%Y-%m-%d %H:%M:%S" 2>/dev/null)
    [ -z "$newexp" ] && { echo "ERROR: Date conversion failed."; return 1; }
    awk -F'|' -v p="$pass" -v ne="$newexp" 'BEGIN{OFS="|"} $1==p {$2=ne} {print}' "$DB" > /tmp/zivpn_tmp.json 2>/dev/null && mv /tmp/zivpn_tmp.json "$DB"
    if [ -f "$CONFIG" ] && command -v jq &>/dev/null; then
        jq -e --arg p "$pass" '.auth.config | index($p) != null' "$CONFIG" >/dev/null 2>&1 || \
            { jq --arg p "$pass" '.auth.config += [$p]' "$CONFIG" > /tmp/zivpn_tmp.json 2>/dev/null && mv /tmp/zivpn_tmp.json "$CONFIG"; }
    fi
    systemctl restart zivpn 2>/dev/null
    echo "User renewed: $pass"
    echo "Expiry: $oldexp -> $newexp"
    echo "Runs for: $(expiry_human "$newexp")"
}

bot_resetbw() {
    local pass="$1"
    [ -z "$pass" ] && { echo "Usage: --bot-resetbw <password>"; return 2; }
    if [ "$pass" = "ALL" ]; then
        while IFS='|' read -r p e q port h u; do
            [ -n "$port" ] && { iptables -Z "UDP_IN_${port}" 2>/dev/null; iptables -Z "UDP_OUT_${port}" 2>/dev/null; }
        done < "$DB"
        awk -F'|' 'BEGIN{OFS="|"} {$2=0; print}' "$USAGE_DB" > /tmp/u_tmp 2>/dev/null && mv /tmp/u_tmp "$USAGE_DB"
        echo "All bandwidth counters reset."
        return 0
    fi
    local line; line=$(awk -F'|' -v p="$pass" '$1 == p {print; exit}' "$DB" 2>/dev/null)
    [ -z "$line" ] && { echo "User not found."; return 1; }
    local port; port=$(echo "$line" | cut -d'|' -f4)
    [ -n "$port" ] && { iptables -Z "UDP_IN_${port}" 2>/dev/null; iptables -Z "UDP_OUT_${port}" 2>/dev/null; }
    awk -F'|' -v p="$pass" 'BEGIN{OFS="|"} $1==p {$2=0} {print}' "$USAGE_DB" > /tmp/u_tmp 2>/dev/null && mv /tmp/u_tmp "$USAGE_DB"
    echo "Bandwidth reset for: $pass"
}

bot_cleanup() {
    if [ ! -f "$DB" ] || [ ! -s "$DB" ]; then echo "No users to clean."; return 0; fi
    local removed=0
    while IFS='|' read -r pass exp quota port hwid used; do
        [ -z "$pass" ] && continue
        if is_expired "$exp"; then
            [ -n "$port" ] && remove_tracking "$port"
            [ -f "$CONFIG" ] && jq --arg p "$pass" '.auth.config -= [$p]' "$CONFIG" > /tmp/zivpn_tmp.json 2>/dev/null && mv /tmp/zivpn_tmp.json "$CONFIG"
            bot_del_line "$DB" "$pass"
            bot_del_line "$USAGE_DB" "$pass"
            bot_del_line "$CONN_LIMIT_FILE" "$pass"
            bot_del_line "$IP_LIMIT_FILE" "$pass"
            bot_del_line "$PAUSE_DB" "$pass"
            bot_del_line "$HWID_ALLOWED_DB" "$pass"
            rm -f "/etc/zivpn/iplist_${pass}.db" 2>/dev/null
            removed=$((removed + 1))
        fi
    done < <(cat "$DB")
    [ "$removed" -gt 0 ] && systemctl restart zivpn 2>/dev/null
    echo "Removed $removed expired user(s)."
}

bot_trial() {
    local minutes="$1"
    [[ "$minutes" =~ ^[0-9]+$ ]] || { echo "ERROR: Trial minutes must be a number."; return 1; }
    [ "$minutes" -lt 1 ] && { echo "ERROR: Minimum 1 minute."; return 1; }
    local trialquota="100MB"
    local exp_days=$(( (minutes + 1439) / 1440 )); [ "$exp_days" -lt 1 ] && exp_days=1
    local hwid finalpass port exp
    hwid="trial_$(openssl rand -hex 4)"
    finalpass=$(openssl rand -base64 32 | tr -d '/=+' | head -c32)
    exp=$(date -d "+${exp_days} days" +%Y-%m-%d 2>/dev/null || date -v "+${exp_days}d" +%Y-%m-%d)
    port=$(bot_add_user_record "$finalpass" "$exp" "$trialquota" "$hwid")
    if [ -z "$port" ] || [[ "$port" == ERROR* ]]; then echo "${port:-ERROR: Failed to create trial user.}"; return 1; fi
    command -v at &>/dev/null || apt-get install -y at -qq >/dev/null 2>&1
    systemctl enable --now atd >/dev/null 2>&1 || systemctl enable --now at >/dev/null 2>&1 || service atd start >/dev/null 2>&1
    at now + ${minutes} minutes >/dev/null 2>&1 <<ATCMD
[ -f "$CONFIG" ] && jq --arg p "${finalpass}" '.auth.config -= [\$p]' "$CONFIG" > /tmp/zivpn_trial_${port}.json && mv /tmp/zivpn_trial_${port}.json "$CONFIG"
sed -i '/^${finalpass}|/d' "$DB" 2>/dev/null
sed -i '/^${finalpass}|/d' "$USAGE_DB" 2>/dev/null
sed -i '/^${finalpass}|/d' "$CONN_LIMIT_FILE" 2>/dev/null
sed -i '/^${finalpass}|/d' "$IP_LIMIT_FILE" 2>/dev/null
sed -i '/^${finalpass}|/d' "$PAUSE_DB" 2>/dev/null
sed -i '/^${finalpass}|/d' "$HWID_ALLOWED_DB" 2>/dev/null
rm -f "/etc/zivpn/iplist_${finalpass}.db" 2>/dev/null
iptables -D INPUT  -p udp --dport ${port} -j UDP_IN_${port}  2>/dev/null
iptables -D OUTPUT -p udp --sport ${port} -j UDP_OUT_${port} 2>/dev/null
iptables -F UDP_IN_${port}  2>/dev/null; iptables -X UDP_IN_${port}  2>/dev/null
iptables -F UDP_OUT_${port} 2>/dev/null; iptables -X UDP_OUT_${port} 2>/dev/null
iptables -D INPUT -p udp --dport ${port} -j ACCEPT 2>/dev/null
iptables -t nat -D PREROUTING -p udp --dport ${port} -j DNAT --to-destination :5667 2>/dev/null
systemctl restart zivpn 2>/dev/null
ATCMD
    echo "Trial user created."
    echo "Password: $finalpass"
    echo "Duration: ${minutes} minute(s)"
    echo "Expiry  : $exp (auto-deleted)"
    echo "Quota   : $trialquota"
    echo "Port    : $port"
    echo "Server  : ${IP:-N/A}"
}


    echo -ne "  ${YLW}║${RST}  ${GRN}Username / Identifier         :${RST} "; read -r basepass
    echo -ne "  ${YLW}║${RST}  ${GRN}Password (empty=random)       :${RST} "; read -r userpass
    echo -ne "  ${YLW}║${RST}  ${GRN}Duration (e.g. 2d4h30m)       :${RST} "; read -r duration

bot_cli_main() {
    fetch_geo >/dev/null 2>&1
    case "$1" in
        --bot-status)      bot_status ;;
        --bot-list)        bot_list ;;
        --bot-userstatus)  bot_userstatus "$2" ;;
        --bot-userinfo)    bot_userstatus "$2" ;;
        --bot-adduser)     bot_adduser "$2" "$3" "$4" "$5" ;;
        --bot-removeuser)  bot_removeuser "$2" ;;
        --bot-renew)       bot_renew "$2" "$3" ;;
        --bot-resetbw)     bot_resetbw "$2" ;;
        --bot-trial)       bot_trial "$2" ;;
        --bot-cleanup)     bot_cleanup ;;
        --bot-bbr)         bot_bbr ;;
        --bot-badvpn)      bot_badvpn ;;
        --bot-ipmon_on)    enable_ip_monitor   >/dev/null 2>&1; echo "IP limit monitor: $(systemctl is-active opudp-ipmon 2>/dev/null)" ;;
        --bot-ipmon_off)   disable_ip_monitor  >/dev/null 2>&1; echo "IP limit monitor disabled." ;;
        --bot-bwmon_on)    enable_bw_monitor   >/dev/null 2>&1; echo "Bandwidth monitor: $(systemctl is-active opudp-bwmon 2>/dev/null)" ;;
        --bot-bwmon_off)   disable_bw_monitor  >/dev/null 2>&1; echo "Bandwidth monitor disabled." ;;
        --bot-enforce_on)  enable_enforcement  >/dev/null 2>&1; echo "Connection enforcement: $( [ -f "$ENFORCE_CRON" ] && echo enabled || echo failed )" ;;
        --bot-enforce_off) disable_enforcement >/dev/null 2>&1; echo "Connection enforcement disabled." ;;
        --bot-hwid_on)     enable_hwid_lock    >/dev/null 2>&1; echo "HWID lock: $(systemctl is-active opudp-hwid-enforcer 2>/dev/null)" ;;
        --bot-hwid_off)    disable_hwid_lock   >/dev/null 2>&1; echo "HWID lock disabled." ;;
        --bot-pausemon_on) enable_pause_monitor >/dev/null 2>&1; echo "Pause monitor: $(systemctl is-active opudp-pausemon 2>/dev/null)" ;;
        --bot-pausemon_off) disable_pause_monitor >/dev/null 2>&1; echo "Pause monitor disabled." ;;
        *) echo "Unknown bot command: $1"; return 1 ;;
    esac
}


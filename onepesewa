# ══════════════════════════════════════════════════════════════
#  CONNECTION LIMIT ENFORCEMENT (cron, every minute)
# ══════════════════════════════════════════════════════════════
ENFORCE_SCRIPT="/usr/local/bin/opudp_enforce_limits.sh"
ENFORCE_CRON="/etc/cron.d/opudp_connlimit"

write_enforce_script() {
    cat > "$ENFORCE_SCRIPT" <<'ENFEOF'
#!/bin/bash
DB="/etc/zivpn/users.db"
CONN_LIMIT_FILE="/etc/zivpn/conn_limits.db"
LOG_FILE="/var/log/opudp_enforce.log"
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"; }
[ ! -f "$DB" ] && exit 0
while IFS='|' read -r pass expiry quota port hwid used; do
    [ -z "$port" ] && continue
    limit=$(grep "^${pass}|" "$CONN_LIMIT_FILE" 2>/dev/null | cut -d'|' -f2)
    [ -z "$limit" ] || [ "$limit" -eq 0 ] && continue
    sessions=$(ss -un state established 2>/dev/null | grep -c ":${port} " || echo 0)
    if [ "$sessions" -gt "$limit" ]; then
        log "User $pass (port $port) has $sessions sessions, limit $limit – killing excess connections"
        conntrack -D -p udp --dport "$port" 2>/dev/null
    fi
done < "$DB"
ENFEOF
    chmod +x "$ENFORCE_SCRIPT"
}

enable_enforcement() {
    write_enforce_script
    echo "* * * * * root $ENFORCE_SCRIPT" > "$ENFORCE_CRON"
    if ! command -v conntrack &>/dev/null; then apt-get install -y conntrack -qq 2>/dev/null; fi
    systemctl restart cron 2>/dev/null || systemctl restart crond 2>/dev/null
    echo -e "\n  ${GRN}✔ Connection limit enforcement enabled (cron every minute).${RST}"
}

disable_enforcement() {
    rm -f "$ENFORCE_SCRIPT" "$ENFORCE_CRON"
    systemctl restart cron 2>/dev/null || systemctl restart crond 2>/dev/null
    echo -e "\n  ${YLW}⚠ Connection enforcement disabled.${RST}"
}

enforcement_status() {
    if [ -f "$ENFORCE_CRON" ]; then
        echo -e "  ${GRN}● Enabled${RST} (cron job every minute)"
    else
        echo -e "  ${RED}● Disabled${RST}"
    fi
}

# ══════════════════════════════════════════════════════════════
#  HWID LOCK FUNCTIONS (new in v2.7.0)
# ══════════════════════════════════════════════════════════════
HWID_ENFORCER_SERVICE="/etc/systemd/system/opudp-hwid-enforcer.service"
HWID_ENFORCER_SCRIPT="/usr/local/bin/opudp_hwid_enforcer.sh"

write_hwid_enforcer() {
    if [ -f "$HWID_ENFORCER_SCRIPT" ]; then return; fi
    cat > "$HWID_ENFORCER_SCRIPT" <<'HWIDEOF'
#!/bin/bash
HWID_DB="/etc/zivpn/hwid_allowed.db"
USER_DB="/etc/zivpn/users.db"
LOG_FILE="/var/log/opudp_hwid_enforcer.log"
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"; }
[ ! -f "$HWID_DB" ] && exit 0
journalctl -u zivpn -n0 -f --no-pager 2>/dev/null | while IFS= read -r line; do
    if echo "$line" | grep -qiE 'connected|accepted'; then
        pass=$(echo "$line" | sed -n 's/.*\(connected\|user\) \([^ ]*\).*/\2/p' | tr -d '[:space:]')
        hwid=$(echo "$line" | sed -n 's/.*hwid[=:]\? \([^\s]*\).*/\1/p' | tr -d '[:space:]')
        ip=$(echo "$line"   | sed -n 's/.*from \([0-9.]\+\).*/\1/p' | tr -d '[:space:]')
        if [ -n "$pass" ] && [ -n "$hwid" ] && [ -n "$ip" ]; then
            allowed_hwid=$(grep "^${pass}|" "$HWID_DB" 2>/dev/null | cut -d'|' -f2)
            if [ -n "$allowed_hwid" ] && [ "$allowed_hwid" != "any" ] && [ "$hwid" != "$allowed_hwid" ]; then
                port=$(grep "^${pass}|" "$USER_DB" 2>/dev/null | cut -d'|' -f4)
                if [ -n "$port" ]; then
                    log "BLOCKED – user $pass, wrong HWID $hwid (allowed $allowed_hwid) from $ip on port $port"
                    iptables -I INPUT -p udp --dport "$port" -s "$ip" -j DROP 2>/dev/null
                    conntrack -D -p udp --dport "$port" -s "$ip" 2>/dev/null
                    echo "$(date) - KICKED $ip (wrong HWID) for user $pass" >> /var/log/opudp_hwid_kick.log
                fi
            fi
        fi
    fi
done
HWIDEOF
    chmod +x "$HWID_ENFORCER_SCRIPT"
}

enable_hwid_lock() {
    write_hwid_enforcer
    cat > "$HWID_ENFORCER_SERVICE" <<UNIT
[Unit]
Description=OP UDP Panel HWID Lock Enforcer
After=zivpn.service
Requires=zivpn.service
[Service]
Type=simple
User=root
ExecStart=$HWID_ENFORCER_SCRIPT
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable opudp-hwid-enforcer 2>/dev/null
    systemctl restart opudp-hwid-enforcer 2>/dev/null
    echo -e "\n  ${GRN}✔ HWID lock enforcer enabled.${RST}"
}

disable_hwid_lock() {
    systemctl stop opudp-hwid-enforcer 2>/dev/null
    systemctl disable opudp-hwid-enforcer 2>/dev/null
    rm -f "$HWID_ENFORCER_SERVICE" "$HWID_ENFORCER_SCRIPT"
    systemctl daemon-reload
    echo -e "\n  ${YLW}⚠ HWID lock enforcement disabled.${RST}"
}

hwid_lock_status() {
    if systemctl is-active --quiet opudp-hwid-enforcer 2>/dev/null; then
        echo -e "  ${GRN}● Enabled${RST} (actively blocking wrong HWIDs)"
    else
        echo -e "  ${RED}● Disabled${RST}"
    fi
}

do_hwid_lock_menu() {
    echo -e "\n  ${CYN}${BOLD}◈  HWID Lock Control${RST}\n"
    hwid_lock_status
    echo ""
    echo -ne "  ${GRN}Enable (E) / Disable (D) / Back (B): ${RST}"; read -r ed
    case $ed in
        [Ee]) enable_hwid_lock; press_enter ;;
        [Dd]) disable_hwid_lock; press_enter ;;
        *) ;;
    esac
}

do_reset_hwid_for_user() {
    echo -e "\n  ${CYN}${BOLD}◈  Reset Allowed HWID (Admin Override)${RST}\n"
    echo -ne "  ${GRN}Enter full password: ${RST}"; read -r pass
    [ -z "$pass" ] && { echo -e "  ${RED}✘  Aborted.${RST}"; press_enter; return; }
    if ! grep -q "^${pass}|" "$DB" 2>/dev/null; then
        echo -e "  ${RED}✘  User not found.${RST}"; press_enter; return
    fi
    local old_hwid=$(grep "^${pass}|" "$HWID_ALLOWED_DB" 2>/dev/null | cut -d'|' -f2)
    echo -e "  ${DIM}Current allowed HWID: ${WHT}${old_hwid:-none}${RST}"
    echo -ne "  ${GRN}Enter new HWID (or leave empty to remove lock): ${RST}"; read -r new_hwid
    sed -i "/^${pass}|/d" "$HWID_ALLOWED_DB" 2>/dev/null
    if [ -n "$new_hwid" ]; then
        echo "${pass}|${new_hwid}" >> "$HWID_ALLOWED_DB"
        local port=$(grep "^${pass}|" "$DB" | cut -d'|' -f4)
        if [ -n "$port" ]; then
            iptables -S INPUT | grep "dport $port" | grep -oP '(?<=-s )\S+' | sort -u | while read blocked_ip; do
                iptables -D INPUT -p udp --dport "$port" -s "$blocked_ip" -j DROP 2>/dev/null
            done
        fi
        echo -e "\n  ${GRN}✔ Allowed HWID updated. Old blocks cleared.${RST}"
    else
        echo -e "\n  ${YLW}HWID lock removed for this user.${RST}"
    fi
    press_enter
}

